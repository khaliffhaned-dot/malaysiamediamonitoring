{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malaysiamediamonitoring",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  {
  // ...
  "d1_databases": [
    {
      "binding": "MEDIA-MONITORING",
      "database_id": "cbb48ffb-7e39-4363-9ad2-3f81c65f6116"
    }
  ],
  "ai": {
    "binding": "mysmedmon"
  },
  // ...
}
  "services": [
    {
      // Self-reference service binding; service name must match the worker name
      "binding": "WORKER_SELF_REFERENCE",
      "service": "malaysiamediamonitoring"
    }
  ],
  "r2_buckets": [
    {
      // R2 incremental cache (ensure this bucket exists in Cloudflare R2 before deploying)
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "nextn-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
